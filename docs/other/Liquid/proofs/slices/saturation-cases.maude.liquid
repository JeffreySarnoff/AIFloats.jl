!--- Constructor abstraction of D1 4.7.5, p.29. Refinement is an explicit obligation.
set include BOOL off .
fmod P3109-PROOF-SATURATION is
  sorts Sat Round Sign Domain Location Outcome .
  ops none finite propagate : -> Sat [ctor] .
  ops up down zero other : -> Round [ctor] .
  ops signed unsigned : -> Sign [ctor] .
  ops extended finiteDomain : -> Domain [ctor] .
  ops qnan inside below above plusInfinity minusInfinity : -> Location [ctor] .
