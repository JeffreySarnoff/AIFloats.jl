  var S : Sat .
  var R : Round .
  var SG : Sign .
  var D : Domain .|
eq~nan~decision(S, R, qnan, SG, D) = outNaN~-|
eq~inrange~decision(S, R, inside, SG, D) = unchanged~-|
eq~finite-posinf~decision(finite, R, plusInfinity, SG, D) = high~-|
eq~finite-neginf~decision(finite, R, minusInfinity, SG, D) = low~-|
eq~finite-high~decision(finite, R, above, SG, D) = high~-|
eq~finite-low~decision(finite, R, below, SG, D) = low~-|
eq~propagate-posinf-ext~decision(propagate, R, plusInfinity, SG, extended) = outPlusInfinity~-|
eq~propagate-posinf-fin~decision(propagate, R, plusInfinity, SG, finiteDomain) = high~-|
eq~propagate-neginf-signed-ext~decision(propagate, R, minusInfinity, signed, extended) = outMinusInfinity~-|
eq~propagate-neginf-unsigned-ext~decision(propagate, R, minusInfinity, unsigned, extended) = low~-|
eq~propagate-neginf-fin~decision(propagate, R, minusInfinity, SG, finiteDomain) = low~-|
eq~propagate-low~decision(propagate, R, below, SG, D) = low~-|
eq~propagate-high~decision(propagate, R, above, SG, D) = high~-|
eq~none-posinf~decision(none, R, plusInfinity, SG, D) = highOverflow(D)~-|
eq~none-neginf~decision(none, R, minusInfinity, SG, D) = lowOverflow(SG, D)~-|
eq~none-high~decision(none, R, above, SG, D) = highNone(R, SG, D)~-|
eq~none-low~decision(none, R, below, SG, D) = lowNone(R, SG, D)~-|
eq~high-zero~highNone(zero, SG, D) = high~-|
eq~high-down~highNone(down, SG, D) = high~-|
eq~high-up~highNone(up, SG, D) = highOverflow(D)~-|
eq~high-other~highNone(other, SG, D) = highOverflow(D)~-|
eq~low-zero~lowNone(zero, SG, D) = low~-|
eq~low-up~lowNone(up, SG, D) = low~-|
eq~low-down~lowNone(down, SG, D) = lowOverflow(SG, D)~-|
eq~low-other~lowNone(other, SG, D) = lowOverflow(SG, D)~-|
eq~high-ext~highOverflow(extended) = outPlusInfinity~-|
eq~high-fin~highOverflow(finiteDomain) = outNaN~-|
eq~low-signed-ext~lowOverflow(signed, extended) = outMinusInfinity~-|
eq~low-unsigned-ext~lowOverflow(unsigned, extended) = outNaN~-|
