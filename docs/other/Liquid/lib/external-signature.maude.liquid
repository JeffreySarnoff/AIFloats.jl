--- Source: P3109/D1 4.8; 4.14, printed page 31; 58.
fmod P3109-EXTERNAL-SIGNATURE is
  including P3109-XREAL .
  including P3109-FORMAT-CORE .
  op externalDecode : Format Int ~> XReal .
  op externalEncode : Format XReal ~> Nat .
  op externalDatum : Format XReal ~> Bool .
  --- Bound queries are an enumeration, not String literals: STRING declares
  --- subsort Nat < FindResult, which would put FindResult into the numeric
  --- kind of every semantic module importing this signature.
  sort BoundQuery .
  ops maxFiniteQuery minFiniteQuery minPositiveQuery maxSubnormalQuery minNormalQuery : -> BoundQuery [ctor] .
  op externalBound : Format BoundQuery ~> Nat .
endfm
