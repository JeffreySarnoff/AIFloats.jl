!--- Source: P3109/D1 4.2; 4.7.4; 4.15; 5.3; 5.8, printed page 18; 27-28; 58; 61; 70.
fmod P3109-PROJSPEC is
  protecting INT .
  including P3109-SEQUENCE{RandomElt} * (sort Seq{RandomElt} to RandomSeq, op nil to rnil, op cons to rcons) .
  sorts RoundMode SatMode ProjSpec BlockRoundMode BlockProjSpec .
  subsort RoundMode < BlockRoundMode .
  ops NearestTiesToEven NearestTiesToAway TowardPositive TowardNegative TowardZero ToOdd : -> RoundMode [ctor] .
