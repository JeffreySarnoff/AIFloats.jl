ceq~p3109-random-negative-bits~randomInRange(N, R) = false if N < 0~clause=4.7.4; page=28|
ceq~p3109-random-range~randomInRange(N, R) = (R >= 0 and R < 2 ^ N) if N >= 0~clause=4.7.4; page=28|
eq~001~validRound(NearestTiesToEven) = true~-|
eq~002~deterministic(NearestTiesToEven) = true~-|
eq~003~validRound(NearestTiesToAway) = true~-|
eq~004~deterministic(NearestTiesToAway) = true~-|
