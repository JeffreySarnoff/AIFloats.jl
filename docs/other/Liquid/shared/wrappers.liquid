{%- comment -%}Shared catalog, views, and instance layouts for SCALAR and BLOCK.{%- endcomment -%}
{%- assign module_prefix = 'P3109-' -%}
{%- assign kernel = 'P3109-OMEGA-EXTREMA' -%}
{%- if profile == 'symbolic' -%}
  {%- assign module_prefix = 'P3109-SYMBOLIC-' -%}
  {%- assign kernel = 'P3109-OMEGA-ELEMENTARY' -%}
{%- endif -%}
{%- capture operations -%}{%- render 'shared/operations', profile: profile -%}{%- endcapture -%}
{%- assign operations = operations | split: '|' -%}
--- Generated by tools/generate-wrappers.py; edit inventory or generator.
{% if kind == 'SCALAR' %}{% for operation in operations %}{% assign fields = operation | strip | split: '~' %}view {{ fields[0] }}Kernel from P3109-KERNEL{{ fields[1] }} to {{ kernel }} is
  op kernel to omega{{ fields[0] }} .
endv
{% endfor %}fmod {{ module_prefix }}SCALAR is
  including P3109-PROJECT .
  including P3109-OMEGA-EXTREMA .
{% else %}fmod {{ module_prefix }}BLOCK-WRAPPERS is
  including P3109-BLOCK .
{% endif %}{% if profile == 'symbolic' %}  including P3109-OMEGA-ELEMENTARY .
{% endif %}{% for operation in operations %}{% assign fields = operation | strip | split: '~' %}{% assign name = fields[0] %}{% assign arity = fields[1] %}  including P3109-{{ kind }}-TEMPLATE{{ arity }}{ {{- name -}}Kernel} * (
{% if kind == 'SCALAR' %}    op scalar to {{ name }},
    label p3109-template-scalar-{{ arity }} to p3109-scalar-{{ name }}) .
{% else %}    op elementwise to Block{{ name }}, op scaled to Scaled{{ name }}, op mapped to map{{ name }},
    label p3109-template-block-{{ arity }} to p3109-block-{{ name }},
    label p3109-template-map-{{ arity }}-nil to p3109-map-{{ name }}-nil,
    label p3109-template-map-{{ arity }}-cons to p3109-map-{{ name }}-cons,
    label p3109-template-scaled-{{ arity }} to p3109-scaled-{{ name }}) .
{% endif %}{% endfor %}endfm
