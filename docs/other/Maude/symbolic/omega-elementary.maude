  ceq [p3109-omega-elementary-094] : omegaTan(U) = posInf if xEq(omegaCos(U), fin(0)) /\ xLt(fin(0), omegaSin(U)) [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  ceq [p3109-omega-elementary-095] : omegaTan(U) = negInf if xEq(omegaCos(U), fin(0)) /\ xLt(omegaSin(U), fin(0)) [metadata "clause=4.10.8-4.10.16; page=40-48"] .
