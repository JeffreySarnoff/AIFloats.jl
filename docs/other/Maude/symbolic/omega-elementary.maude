  eq [p3109-omega-elementary-098] : numeratorOf(NZ / ND) = NZ [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  eq [p3109-omega-elementary-099] : denominatorOf(NZ / ND) = ND [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  ceq [p3109-omega-elementary-100] : exprSqrt(fin(R)) = fin(NS / DS) if R >= 0 /\ N := numeratorOf(R) /\ D := denominatorOf(R) /\ NS := integerSqrt(N) /\ DS := integerSqrt(D) /\ NS * NS == N /\ DS * DS == D [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  eq [p3109-omega-elementary-101] : exprExp(fin(0)) = fin(1) [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  eq [p3109-omega-elementary-102] : exprExp2(fin(K)) = fin(pow2(K)) [metadata "clause=4.10.8-4.10.16; page=40-48"] .
