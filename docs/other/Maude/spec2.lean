    | eqe_inFs {a b : kFormat} : kFormat.eqe a b → kBool.eqe (kBool.inFs a) (kBool.inFs b)
    | eqe_allowedExternal {a b : kFormat} : kFormat.eqe a b → kBool.eqe (kBool.allowedExternal a) (kBool.allowedExternal b)
