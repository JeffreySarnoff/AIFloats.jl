--- Shared arity schemas; operation names and kernel views are generated separately.
--- Source: P3109/D1 5.7-5.8, printed page 69-70.
--- Per-operation clauses are recorded in inventory/operations.json and traceability.tsv.
fmod P3109-BLOCK-TEMPLATE1{O :: P3109-KERNEL1} is
  including P3109-BLOCK .
  vars F1 FS1 FS FR : Format .
  vars C1 S1 S : Int .
  var PS : ProjSpec .
  var B : Nat .
  var BP : BlockProjSpec .
  var CS1 : CodeSeq .
  var XS1 : XSeq .
  var X1 : XReal .
  op elementwise : Nat Format Format Format Format BlockProjSpec Int CodeSeq Int ~> Block .
  op mapped : XSeq ~> XSeq .
  ceq [p3109-template-block-1] :
    elementwise(B, FS1, F1, FS, FR, BP, S1, CS1, S)
    = block(S, blockProject(B, FS, FR, BP, S, mapped(blockDecode(B, FS1, F1, S1, CS1))))
    if validBlock(B, FS1, F1, S1, CS1) /\ validCode(FS, S) /\ validFormat(FR) /\
    validBlockProjection(BP, B)
    [metadata "clause=5.7-5.8; page=69-70"] .
  eq [p3109-template-map-1-nil] :
    mapped(xnil)
    = xnil
    [metadata "clause=5.7-5.8; page=69-70"] .
  eq [p3109-template-map-1-cons] :
    mapped(xcons(X1, XS1))
    = xcons(kernel(X1), mapped(XS1))
    [metadata "clause=5.7-5.8; page=69-70"] .
  op scaled : Format Format Format ProjSpec Int Int ~> Nat .
  ceq [p3109-template-scaled-1] :
    scaled(FS1, F1, FR, PS, S1, C1)
    = scaledResult(elementwise(1, FS1, F1, Binary(4, 2, Signed, Finite), FR, singletonLift(PS), S1,
    ccons(C1, cnil), 4))
    if validCode(FS1, S1) /\ validCode(F1, C1) /\ validFormat(FR) /\ validProjection(PS)
    [metadata "clause=5.7-5.8; page=69-70"] .
endfm
