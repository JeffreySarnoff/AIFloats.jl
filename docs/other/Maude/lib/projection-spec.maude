--- Source: P3109/D1 4.2; 4.7.4; 4.15; 5.3; 5.8, printed page 18; 27-28; 58; 61; 70.
fmod P3109-PROJSPEC is
  protecting INT .
  including P3109-SEQUENCE{RandomElt} * (sort Seq{RandomElt} to RandomSeq, op nil to rnil, op cons to rcons) .
  sorts RoundMode SatMode ProjSpec BlockRoundMode BlockProjSpec .
  subsort RoundMode < BlockRoundMode .
  ops NearestTiesToEven NearestTiesToAway TowardPositive TowardNegative TowardZero ToOdd : -> RoundMode [ctor] .
  ops StochasticA StochasticB StochasticC : Int Int -> RoundMode [ctor] .
  ops BlockStochasticA BlockStochasticB BlockStochasticC : Int RandomSeq -> BlockRoundMode [ctor] .
  ops SatNone SatFinite SatPropagate : -> SatMode [ctor] .
  op proj : RoundMode SatMode -> ProjSpec [ctor] .
  op bproj : BlockRoundMode SatMode -> BlockProjSpec [ctor] .
  op randomInRange : Int Int -> Bool .
  op validRound : RoundMode -> Bool .
  op validProjection : ProjSpec -> Bool .
  op validBlockProjection : BlockProjSpec Nat -> Bool .
  op validRandoms : Int RandomSeq -> Bool .
  op RoundOf : ProjSpec ~> RoundMode .
  op SatOf : ProjSpec ~> SatMode .
  op projectionAt : BlockProjSpec Nat ~> ProjSpec .
  op singletonLift : ProjSpec ~> BlockProjSpec .
  op deterministic : RoundMode -> Bool .
  vars N R : Int .
  vars J B : Nat .
  var RS : RandomSeq .
  var M : RoundMode .
  var S : SatMode .
  ceq [p3109-random-negative-bits] : randomInRange(N, R) = false if N < 0 [metadata "clause=4.7.4; page=28"] .
  ceq [p3109-random-range] : randomInRange(N, R) = (R >= 0 and R < 2 ^ N) if N >= 0 [metadata "clause=4.7.4; page=28"] .
  eq [p3109-projection-spec-001] : validRound(NearestTiesToEven) = true [metadata "clause=4.2; 4.7.4; 4.15; 5.3; 5.8; page=18; 27-28; 58; 61; 70"] .
  eq [p3109-projection-spec-002] : deterministic(NearestTiesToEven) = true [metadata "clause=4.2; 4.7.4; 4.15; 5.3; 5.8; page=18; 27-28; 58; 61; 70"] .
  eq [p3109-projection-spec-003] : validRound(NearestTiesToAway) = true [metadata "clause=4.2; 4.7.4; 4.15; 5.3; 5.8; page=18; 27-28; 58; 61; 70"] .
  eq [p3109-projection-spec-004] : deterministic(NearestTiesToAway) = true [metadata "clause=4.2; 4.7.4; 4.15; 5.3; 5.8; page=18; 27-28; 58; 61; 70"] .
  eq [p3109-projection-spec-005] : validRound(TowardPositive) = true [metadata "clause=4.2; 4.7.4; 4.15; 5.3; 5.8; page=18; 27-28; 58; 61; 70"] .
  eq [p3109-projection-spec-006] : deterministic(TowardPositive) = true [metadata "clause=4.2; 4.7.4; 4.15; 5.3; 5.8; page=18; 27-28; 58; 61; 70"] .
  eq [p3109-projection-spec-007] : validRound(TowardNegative) = true [metadata "clause=4.2; 4.7.4; 4.15; 5.3; 5.8; page=18; 27-28; 58; 61; 70"] .
  eq [p3109-projection-spec-008] : deterministic(TowardNegative) = true [metadata "clause=4.2; 4.7.4; 4.15; 5.3; 5.8; page=18; 27-28; 58; 61; 70"] .
  eq [p3109-projection-spec-009] : validRound(TowardZero) = true [metadata "clause=4.2; 4.7.4; 4.15; 5.3; 5.8; page=18; 27-28; 58; 61; 70"] .
  eq [p3109-projection-spec-010] : deterministic(TowardZero) = true [metadata "clause=4.2; 4.7.4; 4.15; 5.3; 5.8; page=18; 27-28; 58; 61; 70"] .
  eq [p3109-projection-spec-011] : validRound(ToOdd) = true [metadata "clause=4.2; 4.7.4; 4.15; 5.3; 5.8; page=18; 27-28; 58; 61; 70"] .
  eq [p3109-projection-spec-012] : deterministic(ToOdd) = true [metadata "clause=4.2; 4.7.4; 4.15; 5.3; 5.8; page=18; 27-28; 58; 61; 70"] .
  eq [p3109-projection-spec-013] : validRound(StochasticA(N, R)) = randomInRange(N, R) [metadata "clause=4.2; 4.7.4; 4.15; 5.3; 5.8; page=18; 27-28; 58; 61; 70"] .
  eq [p3109-projection-spec-014] : deterministic(StochasticA(N, R)) = false [metadata "clause=4.2; 4.7.4; 4.15; 5.3; 5.8; page=18; 27-28; 58; 61; 70"] .
  eq [p3109-projection-spec-015] : validBlockProjection(bproj(BlockStochasticA(N, RS), S), B) = (B >= 1 and length(RS) == B and validRandoms(N, RS)) [metadata "clause=4.2; 4.7.4; 4.15; 5.3; 5.8; page=18; 27-28; 58; 61; 70"] .
  ceq [p3109-projection-spec-016] : projectionAt(bproj(BlockStochasticA(N, RS), S), J) = proj(StochasticA(N, at(RS, J)), S) if validRandoms(N, RS) /\ J < length(RS) [metadata "clause=4.2; 4.7.4; 4.15; 5.3; 5.8; page=18; 27-28; 58; 61; 70"] .
  ceq [p3109-projection-spec-017] : singletonLift(proj(StochasticA(N, R), S)) = bproj(BlockStochasticA(N, rcons(R, rnil)), S) if validRound(StochasticA(N, R)) [metadata "clause=4.2; 4.7.4; 4.15; 5.3; 5.8; page=18; 27-28; 58; 61; 70"] .
  eq [p3109-projection-spec-018] : validRound(StochasticB(N, R)) = randomInRange(N, R) [metadata "clause=4.2; 4.7.4; 4.15; 5.3; 5.8; page=18; 27-28; 58; 61; 70"] .
  eq [p3109-projection-spec-019] : deterministic(StochasticB(N, R)) = false [metadata "clause=4.2; 4.7.4; 4.15; 5.3; 5.8; page=18; 27-28; 58; 61; 70"] .
  eq [p3109-projection-spec-020] : validBlockProjection(bproj(BlockStochasticB(N, RS), S), B) = (B >= 1 and length(RS) == B and validRandoms(N, RS)) [metadata "clause=4.2; 4.7.4; 4.15; 5.3; 5.8; page=18; 27-28; 58; 61; 70"] .
  ceq [p3109-projection-spec-021] : projectionAt(bproj(BlockStochasticB(N, RS), S), J) = proj(StochasticB(N, at(RS, J)), S) if validRandoms(N, RS) /\ J < length(RS) [metadata "clause=4.2; 4.7.4; 4.15; 5.3; 5.8; page=18; 27-28; 58; 61; 70"] .
  ceq [p3109-projection-spec-022] : singletonLift(proj(StochasticB(N, R), S)) = bproj(BlockStochasticB(N, rcons(R, rnil)), S) if validRound(StochasticB(N, R)) [metadata "clause=4.2; 4.7.4; 4.15; 5.3; 5.8; page=18; 27-28; 58; 61; 70"] .
  eq [p3109-projection-spec-023] : validRound(StochasticC(N, R)) = randomInRange(N, R) [metadata "clause=4.2; 4.7.4; 4.15; 5.3; 5.8; page=18; 27-28; 58; 61; 70"] .
  eq [p3109-projection-spec-024] : deterministic(StochasticC(N, R)) = false [metadata "clause=4.2; 4.7.4; 4.15; 5.3; 5.8; page=18; 27-28; 58; 61; 70"] .
  eq [p3109-projection-spec-025] : validBlockProjection(bproj(BlockStochasticC(N, RS), S), B) = (B >= 1 and length(RS) == B and validRandoms(N, RS)) [metadata "clause=4.2; 4.7.4; 4.15; 5.3; 5.8; page=18; 27-28; 58; 61; 70"] .
  ceq [p3109-projection-spec-026] : projectionAt(bproj(BlockStochasticC(N, RS), S), J) = proj(StochasticC(N, at(RS, J)), S) if validRandoms(N, RS) /\ J < length(RS) [metadata "clause=4.2; 4.7.4; 4.15; 5.3; 5.8; page=18; 27-28; 58; 61; 70"] .
  ceq [p3109-projection-spec-027] : singletonLift(proj(StochasticC(N, R), S)) = bproj(BlockStochasticC(N, rcons(R, rnil)), S) if validRound(StochasticC(N, R)) [metadata "clause=4.2; 4.7.4; 4.15; 5.3; 5.8; page=18; 27-28; 58; 61; 70"] .
  eq [p3109-projection-spec-028] : validProjection(proj(M, S)) = validRound(M) [metadata "clause=4.2; 4.7.4; 4.15; 5.3; 5.8; page=18; 27-28; 58; 61; 70"] .
  ceq [p3109-projection-spec-029] : RoundOf(proj(M, S)) = M if validProjection(proj(M, S)) [metadata "clause=4.2; 4.7.4; 4.15; 5.3; 5.8; page=18; 27-28; 58; 61; 70"] .
  ceq [p3109-projection-spec-030] : SatOf(proj(M, S)) = S if validProjection(proj(M, S)) [metadata "clause=4.2; 4.7.4; 4.15; 5.3; 5.8; page=18; 27-28; 58; 61; 70"] .
  eq [p3109-projection-spec-031] : validRandoms(N, rnil) = (N >= 0) [metadata "clause=4.2; 4.7.4; 4.15; 5.3; 5.8; page=18; 27-28; 58; 61; 70"] .
  eq [p3109-projection-spec-032] : validRandoms(N, rcons(R, RS)) = (randomInRange(N, R) and validRandoms(N, RS)) [metadata "clause=4.2; 4.7.4; 4.15; 5.3; 5.8; page=18; 27-28; 58; 61; 70"] .
  eq [p3109-projection-spec-033] : validBlockProjection(bproj(M, S), B) = (B >= 1 and validRound(M) and deterministic(M)) [metadata "clause=4.2; 4.7.4; 4.15; 5.3; 5.8; page=18; 27-28; 58; 61; 70"] .
  ceq [p3109-projection-spec-034] : projectionAt(bproj(M, S), J) = proj(M, S) if validRound(M) /\ deterministic(M) [metadata "clause=4.2; 4.7.4; 4.15; 5.3; 5.8; page=18; 27-28; 58; 61; 70"] .
  ceq [p3109-projection-spec-035] : singletonLift(proj(M, S)) = bproj(M, S) if validRound(M) /\ deterministic(M) [metadata "clause=4.2; 4.7.4; 4.15; 5.3; 5.8; page=18; 27-28; 58; 61; 70"] .
endfm
