  axiom eq_trunc₀ {k : MRat} : k.has_sort MSort.Int → (trunc k) = k
  axiom eq_trunc₁ {i n : MRat} : i.has_sort MSort.NzInt → n.has_sort MSort.NzNat → (trunc (i / n)) = (((Int.tdiv i.num n.num : Int) : Rat))
