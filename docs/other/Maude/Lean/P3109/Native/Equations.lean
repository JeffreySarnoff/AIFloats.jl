  axiom eq_frac₁ {i n : MRat} : i.has_sort MSort.NzInt → n.has_sort MSort.NzNat → (frac (i / n)) = ((((Int.tmod i.num n.num : Int) : Rat)) / n)
  axiom eq_floor₀ {k : MRat} : k.has_sort MSort.Int → (floor k) = k
  axiom eq_ceiling₀ {k : MRat} : k.has_sort MSort.Int → (ceiling k) = k
  axiom eq_floor₁ {n m : MRat} : n.has_sort MSort.NzNat → m.has_sort MSort.NzNat → (floor (n / m)) = (((Int.tdiv n.num m.num : Int) : Rat))
  axiom eq_ceiling₁ {n m : MRat} : n.has_sort MSort.NzNat → m.has_sort MSort.NzNat → (ceiling (n / m)) = (((Int.tdiv ((n + m) - (1 : MRat)).num m.num : Int) : Rat))
  axiom eq_floor₂ {n m : MRat} : n.has_sort MSort.NzNat → m.has_sort MSort.NzNat → (floor ((- n) / m)) = (- (ceiling (n / m)))
  axiom eq_ceiling₂ {n m : MRat} : n.has_sort MSort.NzNat → m.has_sort MSort.NzNat → (ceiling ((- n) / m)) = (- (floor (n / m)))
