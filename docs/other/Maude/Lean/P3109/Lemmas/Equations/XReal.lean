  -- Reflexivity and congruence lemmas
  @[simp] theorem eqe_refl (a : kXReal) : a.eqe a := eqe.from_eqa eqa.refl
  theorem eqa_congr {a b c d : kXReal} : a.eqa b → c.eqa d → (a.eqa c) = (b.eqa d)
    := generic_congr @eqa.trans @eqa.trans @eqa.symm
  theorem eqe_congr {a b c d : kXReal} : a.eqe b → c.eqe d → (a.eqe c) = (b.eqe d)
    := generic_congr @eqe.trans @eqe.trans @eqe.symm
  theorem eqa_eqe_congr {a b c d : kXReal} : a.eqa b → c.eqa d → (a.eqe c) = (b.eqe d)
    := generic_congr (λ {x y z} => (@eqe.trans x y z) ∘ (@eqe.from_eqa x y))
      (λ {x y z h} => (@eqe.trans x y z h) ∘ (@eqe.from_eqa y z)) @eqa.symm

