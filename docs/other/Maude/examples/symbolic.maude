load ../load-symbolic.maude
red in P3109-SYMBOLIC : omegaSqrt(fin(9/16)) .
red in P3109-SYMBOLIC : omegaSqrt(fin(2)) .
red in P3109-SYMBOLIC : omegaArcTan2Pi(fin(1), fin(-1)) .
red in P3109-SYMBOLIC : omegaTanPi(fin(-1/2)) .
--- This is a residual comparison, not false.
red in P3109-SYMBOLIC : xEq(exprExp(fin(1)), exprExp(fin(2))) .
quit
