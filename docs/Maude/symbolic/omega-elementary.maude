  eq [p3109-omega-elementary-093] : omegaArcTanPi(X) = omegaDivide(omegaArcTan(X), pi) [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  ceq [p3109-omega-elementary-094] : omegaTan(U) = posInf if xEq(omegaCos(U), 0) /\ xLt(0, omegaSin(U)) [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  ceq [p3109-omega-elementary-095] : omegaTan(U) = negInf if xEq(omegaCos(U), 0) /\ xLt(omegaSin(U), 0) [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  op numeratorOf : Rat -> Int .
  op denominatorOf : Rat -> Nat .
  eq [p3109-omega-elementary-096] : numeratorOf(K) = K [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  eq [p3109-omega-elementary-097] : denominatorOf(K) = 1 [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  vars NZ : NzInt .
  var ND : NzNat .
  eq [p3109-omega-elementary-098] : numeratorOf(NZ / ND) = NZ [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  eq [p3109-omega-elementary-099] : denominatorOf(NZ / ND) = ND [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  ceq [p3109-omega-elementary-100] : exprSqrt(R) = NS / DS if R >= 0 /\ N := numeratorOf(R) /\ D := denominatorOf(R) /\ NS := integerSqrt(N) /\ DS := integerSqrt(D) /\ NS * NS == N /\ DS * DS == D [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  eq [p3109-omega-elementary-101] : exprExp(0) = 1 [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  eq [p3109-omega-elementary-102] : exprExp2(K) = pow2(K) [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  eq [p3109-omega-elementary-103] : exprLog(1) = 0 [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  ceq [p3109-omega-elementary-104] : exprLog2(R) = K if R > 0 /\ K := floorLog2(R) /\ R == pow2(K) [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  eq [p3109-omega-elementary-105] : exprSin(0) = 0 [metadata "clause=4.10.8-4.10.16; page=40-48"] .
