  eq [p3109-omega-elementary-085] : omegaLogOnePlus(X) = omegaLog(omegaAdd(1, X)) [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  eq [p3109-omega-elementary-086] : omegaExpMinusOne(X) = omegaSubtract(omegaExp(X), 1) [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  eq [p3109-omega-elementary-087] : omegaSoftplus(X) = omegaLog(omegaAdd(1, omegaExp(X))) [metadata "clause=4.10.8-4.10.16; page=40-48"] .
