  ceq [p3109-omega-elementary-123] : exprSin(piMultiple(R)) = 0 if R == floor(R) [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  ceq [p3109-omega-elementary-124] : exprSin(piMultiple(R)) = if even(floor(R)) then 1 else -1 fi if R - floor(R) == 1/2 [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  ceq [p3109-omega-elementary-125] : exprCos(piMultiple(R)) = if even(floor(R)) then 1 else -1 fi if R == floor(R) [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  ceq [p3109-omega-elementary-126] : exprCos(piMultiple(R)) = 0 if R - floor(R) == 1/2 [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  ceq [p3109-omega-elementary-127] : exprTan(piMultiple(R)) = 0 if R == floor(R) [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  ceq [p3109-omega-elementary-128] : xEq(exprCos(R), 0) = false if R =/= 0 [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  eq [p3109-omega-elementary-129] : xLt(0, exprExp(U)) = true [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  eq [p3109-omega-elementary-130] : xEq(exprExp(U), 0) = false [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  eq [p3109-omega-elementary-131] : xLt(exprExp(U), 0) = false [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  eq [p3109-omega-elementary-132] : xLt(0, exprExp2(U)) = true [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  eq [p3109-omega-elementary-133] : xEq(exprExp2(U), 0) = false [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  eq [p3109-omega-elementary-134] : xLt(exprExp2(U), 0) = false [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  ceq [p3109-omega-elementary-135] : xLt(0, exprSqrt(U)) = true if xLt(0, U) [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  ceq [p3109-omega-elementary-136] : xEq(exprSqrt(U), 0) = false if xLt(0, U) [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  ceq [p3109-omega-elementary-137] : xLt(exprSqrt(U), 0) = false if xLe(0, U) [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  eq [p3109-omega-elementary-138] : omegaHypot(nan, X) = nan [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  eq [p3109-omega-elementary-139] : omegaHypot(A, nan) = nan [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  eq [p3109-omega-elementary-140] : omegaHypot(A, I) = posInf [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  eq [p3109-omega-elementary-141] : omegaHypot(I, U) = posInf [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  eq [p3109-omega-elementary-142] : omegaHypot(U, V) = omegaSqrt(realAdd(realMultiply(U, U), realMultiply(V, V))) [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  eq [p3109-omega-elementary-143] : omegaArcTan2(nan, X) = nan [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  eq [p3109-omega-elementary-144] : omegaArcTan2(A, nan) = nan [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  eq [p3109-omega-elementary-145] : omegaArcTan2(0, 0) = nan [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  eq [p3109-omega-elementary-146] : omegaArcTan2(I, J) = nan [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  eq [p3109-omega-elementary-147] : omegaArcTan2(U, posInf) = 0 [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  ceq [p3109-omega-elementary-148] : omegaArcTan2(0, U) = 0 if xLt(0, U) [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  eq [p3109-omega-elementary-149] : omegaArcTan2(posInf, U) = piMultiple(1/2) [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  ceq [p3109-omega-elementary-150] : omegaArcTan2(U, 0) = piMultiple(1/2) if xLt(0, U) [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  ceq [p3109-omega-elementary-151] : omegaArcTan2(U, negInf) = pi if xLe(0, U) [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  ceq [p3109-omega-elementary-152] : omegaArcTan2(U, negInf) = piMultiple(-1) if xLt(U, 0) [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  ceq [p3109-omega-elementary-153] : omegaArcTan2(0, U) = pi if xLt(U, 0) [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  eq [p3109-omega-elementary-154] : omegaArcTan2(negInf, U) = piMultiple(-1/2) [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  ceq [p3109-omega-elementary-155] : omegaArcTan2(U, 0) = piMultiple(-1/2) if xLt(U, 0) [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  ceq [p3109-omega-elementary-156] : omegaArcTan2(U, V) = omegaArcTan(omegaDivide(U, V)) if xLt(0, V) /\ xEq(U, 0) == false [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  ceq [p3109-omega-elementary-157] : omegaArcTan2(U, V) = omegaAdd(omegaArcTan(omegaDivide(U, V)), pi) if xLt(0, U) /\ xLt(V, 0) [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  ceq [p3109-omega-elementary-158] : omegaArcTan2(U, V) = omegaSubtract(omegaArcTan(omegaDivide(U, V)), pi) if xLt(U, 0) /\ xLt(V, 0) [metadata "clause=4.10.8-4.10.16; page=40-48"] .
  eq [p3109-omega-elementary-159] : omegaArcTan2Pi(X, Y) = omegaDivide(omegaArcTan2(X, Y), pi) [metadata "clause=4.10.8-4.10.16; page=40-48"] .
