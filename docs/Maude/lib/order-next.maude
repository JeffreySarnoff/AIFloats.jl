--- Source: P3109/D1 4.12.1; 4.16, printed page 54; 59-60.
fmod P3109-ORDER-NEXT is
  including P3109-PREDICATES .
  op TotalOrder : Format Format Int Int ~> Bool .
  ops NextGreaterThan NextLessThan : Format Int ~> Nat .
  op nextCode : Format Int Bool ~> Nat .
  vars F G : Format .
  vars C D : Int .
  ceq [p3109-order-next-001] : TotalOrder(F, G, C, D) = true if validCode(F, C) /\ validCode(G, D) /\ internalFormat(F) /\ internalFormat(G) /\ IsNaN(F, C) [metadata "clause=4.12.1; 4.16; page=54; 59-60"] .
  ceq [p3109-order-next-002] : TotalOrder(F, G, C, D) = false if validCode(F, C) /\ validCode(G, D) /\ internalFormat(F) /\ internalFormat(G) /\ not IsNaN(F, C) /\ IsNaN(G, D) [metadata "clause=4.12.1; 4.16; page=54; 59-60"] .
  ceq [p3109-order-next-003] : TotalOrder(F, G, C, D) = CompareLessEqual(F, G, C, D) if validCode(F, C) /\ validCode(G, D) /\ internalFormat(F) /\ internalFormat(G) /\ not IsNaN(F, C) /\ not IsNaN(G, D) [metadata "clause=4.12.1; 4.16; page=54; 59-60"] .
  ceq [p3109-order-next-004] : NextGreaterThan(F, C) = nanCode(F) if validCode(F, C) /\ internalFormat(F) /\ (IsNaN(F, C) or xEq(decode(F, C), posInf) or (DomainOf(F) == Finite and C == MaxFiniteOf(F))) [metadata "clause=4.12.1; 4.16; page=54; 59-60"] .
  ceq [p3109-order-next-005] : NextGreaterThan(F, C) = nextCode(F, C, true) if validCode(F, C) /\ internalFormat(F) /\ not IsNaN(F, C) /\ not xEq(decode(F, C), posInf) /\ not (DomainOf(F) == Finite and C == MaxFiniteOf(F)) [metadata "clause=4.12.1; 4.16; page=54; 59-60"] .
  ceq [p3109-order-next-006] : NextLessThan(F, C) = nanCode(F) if validCode(F, C) /\ internalFormat(F) /\ (IsNaN(F, C) or xEq(decode(F, C), negInf) or (DomainOf(F) == Finite and C == MinFiniteOf(F)) or (SignednessOf(F) == Unsigned and C == 0)) [metadata "clause=4.12.1; 4.16; page=54; 59-60"] .
  ceq [p3109-order-next-007] : NextLessThan(F, C) = nextCode(F, C, false) if validCode(F, C) /\ internalFormat(F) /\ not IsNaN(F, C) /\ not xEq(decode(F, C), negInf) /\ not (DomainOf(F) == Finite and C == MinFiniteOf(F)) /\ not (SignednessOf(F) == Unsigned and C == 0) [metadata "clause=4.12.1; 4.16; page=54; 59-60"] .
  ceq [p3109-order-next-008] : nextCode(F, C, true) = if C == nanCode(F) + 1 then 0 else C - 1 fi if IsSignMinus(F, C) [metadata "clause=4.12.1; 4.16; page=54; 59-60"] .
  ceq [p3109-order-next-009] : nextCode(F, C, true) = C + 1 if not IsSignMinus(F, C) [metadata "clause=4.12.1; 4.16; page=54; 59-60"] .
  ceq [p3109-order-next-010] : nextCode(F, C, false) = C + 1 if IsSignMinus(F, C) [metadata "clause=4.12.1; 4.16; page=54; 59-60"] .
  ceq [p3109-order-next-011] : nextCode(F, 0, false) = nanCode(F) + 1 if SignednessOf(F) == Signed [metadata "clause=4.12.1; 4.16; page=54; 59-60"] .
  ceq [p3109-order-next-012] : nextCode(F, C, false) = C - 1 if C > 0 /\ not IsSignMinus(F, C) [metadata "clause=4.12.1; 4.16; page=54; 59-60"] .
endfm
