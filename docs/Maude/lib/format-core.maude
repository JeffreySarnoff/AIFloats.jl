  eq [p3109-format-core-021] : DomainOf(binary64) = Extended [metadata "clause=3.1-3.2; 4.14; page=16-17; 58"] .
  eq [p3109-format-core-022] : formatName(binary64) = "binary64" [metadata "clause=3.1-3.2; 4.14; page=16-17; 58"] .
  eq [p3109-format-core-023] : validFormat(binary32) = true [metadata "clause=3.1-3.2; 4.14; page=16-17; 58"] .
