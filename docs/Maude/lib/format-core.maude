  eq [p3109-format-core-018] : PrecisionOf(binary64) = 53 [metadata "clause=3.1-3.2; 4.14; page=16-17; 58"] .
  eq [p3109-format-core-019] : ExponentBiasOf(binary64) = 1023 [metadata "clause=3.1-3.2; 4.14; page=16-17; 58"] .
