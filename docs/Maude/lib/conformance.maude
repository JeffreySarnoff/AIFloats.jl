--- Source: P3109/D1 4.4-4.6, printed page 21-24.
view FormatElt from TRIV to P3109-FORMAT-CORE is
  sort Elt to Format .
endv
fmod P3109-CONFORMANCE-DATA is
  including P3109-BLOCK-CORE .
  including P3109-SEQUENCE{FormatElt} * (sort Seq{FormatElt} to FormatSeq, op nil to fnil, op cons to fcons) .
  sorts Specialization Kappa Observation Declaration Evidence KappaPart .
  op numeric : String FormatSeq ProjSpec -> Specialization [ctor] .
  op plain : String FormatSeq -> Specialization [ctor] .
  op blockElements : String Nat FormatSeq BlockProjSpec -> Specialization [ctor] .
  op blockReduction : String Nat FormatSeq ProjSpec -> Specialization [ctor] .
  op blockScale : String Nat FormatSeq ProjSpec BlockProjSpec -> Specialization [ctor] .
  op steps : Nat -> Kappa [ctor] .
  ops kNaN kInfinity : -> Kappa [ctor] .
  op kappaPart : CodeSeq Kappa -> KappaPart [ctor] .
  op observation : String CodeSeq Format Int Int -> Observation [ctor] .
  ops pendingEvidence sampleEvidence exhaustiveEvidence proofEvidence : -> Evidence [ctor] .
  op exact : Specialization String Evidence -> Declaration [ctor] .
  op approximate : Specialization String Kappa Evidence -> Declaration [ctor] .
endfm
view ObservationElt from TRIV to P3109-CONFORMANCE-DATA is
  sort Elt to Observation .
endv
view KappaPartElt from TRIV to P3109-CONFORMANCE-DATA is
  sort Elt to KappaPart .
endv
view CodeSeqElt from TRIV to P3109-BLOCK-CORE is
  sort Elt to CodeSeq .
endv
view DeclarationElt from TRIV to P3109-CONFORMANCE-DATA is
  sort Elt to Declaration .
endv
view SpecializationElt from TRIV to P3109-CONFORMANCE-DATA is
  sort Elt to Specialization .
endv
fmod P3109-CONFORMANCE is
  including P3109-SEQUENCE{KappaPartElt} * (sort Seq{KappaPartElt} to KappaPartSeq, op nil to knil, op cons to kcons) .
  op partitioned : Specialization String CodeSeq KappaPartSeq Evidence -> Declaration [ctor] .
  op partRegions : KappaPartSeq -> PartitionSeq .
  op partBound : KappaPartSeq -> Kappa .
  op declarationKappa : Declaration ~> Kappa .
  including P3109-SEQUENCE{CodeSeqElt} * (sort Seq{CodeSeqElt} to PartitionSeq, op nil to pnil, op cons to pcons) .
  including P3109-SEQUENCE{DeclarationElt} * (sort Seq{DeclarationElt} to DeclarationSeq, op nil to dnil, op cons to dcons) .
  including P3109-SEQUENCE{SpecializationElt} * (sort Seq{SpecializationElt} to SpecializationSeq, op nil to snil, op cons to scons) .
  including P3109-CONFORMANCE-DATA .
  including P3109-PREDICATES .
  including P3109-SEQUENCE{ObservationElt} * (sort Seq{ObservationElt} to ObservationSeq, op nil to onil, op cons to ocons) .
  ops inF4 inF8 inFs allowedExternal : Format -> Bool .
  op containsFormat : Format FormatSeq -> Bool .
  op validFX : FormatSeq -> Bool .
  op validFXTail : FormatSeq -> Bool .
  op allFormats : FormatSeq -> Bool .
  op required : Specialization FormatSeq -> Bool .
  ops requiredNumeric requiredPlain : String FormatSeq FormatSeq -> Bool .
  ops minmaxName compareName predicateName formatNameOp : String -> Bool .
  op specializationName : Specialization -> String .
  op numericPlainName : String -> Bool .
  op blockElementArity : String Nat -> Bool .
  op numericResult : Specialization -> Bool .
  op declaredIdentity : Declaration -> Specialization .
  op hasDeclaration : Specialization DeclarationSeq -> Bool .
  op declarationsCover : SpecializationSeq DeclarationSeq -> Bool .
  op partition : CodeSeq PartitionSeq -> Bool .
  op partitionUnion : PartitionSeq -> CodeSeq .
  op partitionDisjoint : PartitionSeq -> Bool .
  op validSpecialization : Specialization -> Bool .
  op numericArity : String Nat -> Bool .
  op plainArity : String Nat -> Bool .
  op wellFormedDeclaration : Declaration -> Bool .
  op evidenceComplete : Evidence -> Bool .
  op finiteRank : Format Int ~> Nat .
  op observationKappa : Observation ~> Kappa .
  op batchKappa : ObservationSeq ~> Kappa .
  op mergeKappa : Kappa Kappa -> Kappa .
  op memberCode : Int CodeSeq -> Bool .
  op disjointCodes : CodeSeq CodeSeq -> Bool .
  op uniqueCodes : CodeSeq -> Bool .
  op appendCodes : CodeSeq CodeSeq -> CodeSeq .
  op subsetCodes : CodeSeq CodeSeq -> Bool .
  op partition2 : CodeSeq CodeSeq CodeSeq -> Bool .
  vars F G H J L : Format .
  vars FS FX : FormatSeq .
  vars N NAME : String .
  vars S T : Specialization .
  var PS : ProjSpec .
  vars C D : Int .
  vars A B : Nat .
  vars CS DS ES : CodeSeq .
  vars K Q : Kappa .
  var O : Observation .
  var OS : ObservationSeq .
  var E : Evidence .
  var BP : BlockProjSpec .
  var PARTS : PartitionSeq .
  var KP : KappaPartSeq .
  var DEC : Declaration .
  var DECS : DeclarationSeq .
  var SPECS : SpecializationSeq .
  eq [p3109-conformance-001] : inF4(F) = (F == Binary(4, 2, Signed, Finite)) [metadata "clause=4.4-4.6; page=21-24"] .
  eq [p3109-conformance-002] : inF8(F) = (F == Binary(8, 4, Signed, Extended) or F == Binary(8, 3, Signed, Extended)) [metadata "clause=4.4-4.6; page=21-24"] .
  eq [p3109-conformance-003] : inFs(F) = (F == Binary(8, 1, Unsigned, Finite)) [metadata "clause=4.4-4.6; page=21-24"] .
  eq [p3109-conformance-004] : allowedExternal(F) = (F == binary32 or F == binary16 or F == BFloat16) [metadata "clause=4.4-4.6; page=21-24"] .
  eq [p3109-conformance-005] : containsFormat(F, fnil) = false [metadata "clause=4.4-4.6; page=21-24"] .
  eq [p3109-conformance-006] : containsFormat(F, fcons(G, FS)) = (F == G or containsFormat(F, FS)) [metadata "clause=4.4-4.6; page=21-24"] .
  eq [p3109-conformance-007] : validFX(fnil) = false [metadata "clause=4.4-4.6; page=21-24"] .
  eq [p3109-conformance-008] : validFX(fcons(F, FS)) = allowedExternal(F) and not containsFormat(F, FS) and validFXTail(FS) [metadata "clause=4.4-4.6; page=21-24"] .
  eq [p3109-conformance-009] : validFXTail(fnil) = true [metadata "clause=4.4-4.6; page=21-24"] .
  eq [p3109-conformance-010] : validFXTail(fcons(F, FS)) = allowedExternal(F) and not containsFormat(F, FS) and validFXTail(FS) [metadata "clause=4.4-4.6; page=21-24"] .
  eq [p3109-conformance-011] : allFormats(fnil) = true [metadata "clause=4.4-4.6; page=21-24"] .
  eq [p3109-conformance-012] : allFormats(fcons(F, FS)) = validFormat(F) and allFormats(FS) [metadata "clause=4.4-4.6; page=21-24"] .
  eq [p3109-conformance-013] : required(numeric(N, FS, PS), FX) = validFX(FX) and (PS == proj(NearestTiesToEven, SatNone)) and requiredNumeric(N, FS, FX) [metadata "clause=4.4-4.6; page=21-24"] .
  eq [p3109-conformance-014] : required(plain(N, FS), FX) = validFX(FX) and requiredPlain(N, FS, FX) [metadata "clause=4.4-4.6; page=21-24"] .
  eq [p3109-conformance-015] : requiredNumeric(N, fcons(F, fcons(G, fnil)), FX) = (((N == "Convert" or N == "Recip") and (inF4(F) or inF8(F) or containsFormat(F, FX)) and (inF4(G) or inF8(G) or containsFormat(G, FX))) or ((N == "Abs" or N == "Negate") and F == G and (inF4(F) or inF8(F)))) [metadata "clause=4.4-4.6; page=21-24"] .
  eq [p3109-conformance-016] : requiredNumeric(N, fcons(F, fcons(G, fcons(H, fnil))), FX) = (((N == "Add" or N == "Subtract" or N == "Multiply") and (inF4(F) or inF8(F)) and (inF4(G) or inF8(G)) and (inF8(H) or containsFormat(H, FX))) or (minmaxName(N) and F == G and G == H and (inF4(F) or inF8(F)))) [metadata "clause=4.4-4.6; page=21-24"] .
  eq [p3109-conformance-017] : requiredNumeric(N, fcons(F, fcons(G, fcons(H, fcons(J, fnil)))), FX) = ((N == "FMA" or N == "FAA") and (inF4(F) or inF8(F)) and (inF4(G) or inF8(G)) and H == J and containsFormat(H, FX)) [metadata "clause=4.4-4.6; page=21-24"] .
  eq [p3109-conformance-018] : requiredNumeric(N, fcons(F, fcons(G, fcons(H, fcons(J, fcons(L, fnil))))), FX) = ((N == "ScaledAdd" or N == "ScaledSubtract" or N == "ScaledMultiply") and inFs(F) and F == H and (inF4(G) or inF8(G)) and (inF4(J) or inF8(J)) and (inF8(L) or containsFormat(L, FX))) [metadata "clause=4.4-4.6; page=21-24"] .
  ceq [p3109-conformance-019] : requiredNumeric(N, FS, FX) = false if length(FS) < 2 or length(FS) > 5 [metadata "clause=4.4-4.6; page=21-24"] .
  eq [p3109-conformance-020] : requiredPlain(N, fcons(F, fnil), FX) = ((predicateName(N) and (inF4(F) or inF8(F))) or (formatNameOp(N) and (inF4(F) or inF8(F) or containsFormat(F, FX)))) [metadata "clause=4.4-4.6; page=21-24"] .
  eq [p3109-conformance-021] : requiredPlain(N, fcons(F, fcons(G, fnil)), FX) = (compareName(N) and F == G and (inF4(F) or inF8(F))) [metadata "clause=4.4-4.6; page=21-24"] .
