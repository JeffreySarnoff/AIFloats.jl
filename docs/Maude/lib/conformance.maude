  eq [p3109-conformance-025] : predicateName(N) = (N == "IsZero" or N == "IsOne" or N == "IsNaN" or N == "IsInfinite" or N == "IsFinite" or N == "IsSignMinus" or N == "IsNormal" or N == "IsSubnormal" or N == "NextGreaterThan" or N == "NextLessThan") [metadata "clause=4.4-4.6; page=21-24"] .
  eq [p3109-conformance-026] : formatNameOp(N) = (N == "BitwidthOf" or N == "PrecisionOf" or N == "SignednessOf" or N == "DomainOf" or N == "ExponentBitwidthOf" or N == "TrailingSignificandBitwidthOf" or N == "ExponentBiasOf" or N == "MaxFiniteOf" or N == "MinFiniteOf" or N == "MinPositiveOf" or N == "MaxSubnormalOf" or N == "MinNormalOf") [metadata "clause=4.4-4.6; page=21-24"] .
