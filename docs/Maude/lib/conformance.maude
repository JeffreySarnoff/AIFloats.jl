  ceq [p3109-decl-numeric-2] : numericArity(N, A) = true if A == 2 /\ (N == "Convert" or N == "Abs" or N == "Negate" or N == "Sqrt" or N == "Recip" or N == "RSqrt" or N == "Exp" or N == "Exp2" or N == "Log" or N == "Log2" or N == "LogOnePlus" or N == "ExpMinusOne" or N == "Sin" or N == "Cos" or N == "Tan" or N == "ArcSin" or N == "ArcCos" or N == "ArcTan" or N == "Sinh" or N == "Cosh" or N == "Tanh" or N == "ArcSinh" or N == "ArcCosh" or N == "ArcTanh" or N == "SinPi" or N == "CosPi" or N == "TanPi" or N == "ArcSinPi" or N == "ArcCosPi" or N == "ArcTanPi" or N == "Softplus") [metadata "clause=4.3; page=19-20"] .
  ceq [p3109-decl-numeric-3] : numericArity(N, A) = true if A == 3 /\ (N == "CopySign" or N == "Add" or N == "Subtract" or N == "Multiply" or N == "Divide" or N == "Hypot" or N == "ArcTan2" or N == "ArcTan2Pi" or N == "Minimum" or N == "Maximum" or N == "MinimumNumber" or N == "MaximumNumber" or N == "MinimumMagnitude" or N == "MaximumMagnitude" or N == "MinimumMagnitudeNumber" or N == "MaximumMagnitudeNumber" or N == "MinimumFinite" or N == "MaximumFinite") [metadata "clause=4.3; page=19-20"] .
