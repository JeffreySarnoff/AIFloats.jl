  ceq [p3109-decl-plain-2] : plainArity(N, A) = true if A == 2 /\ (N == "CompareLess" or N == "CompareLessEqual" or N == "CompareEqual" or N == "CompareGreater" or N == "CompareGreaterEqual" or N == "TotalOrder") [metadata "clause=4.3; page=19-20"] .
  ceq [p3109-decl-plain-1] : plainArity(N, A) = true if A == 1 /\ (N == "IsZero" or N == "IsOne" or N == "IsNaN" or N == "IsInfinite" or N == "IsFinite" or N == "IsSignMinus" or N == "IsNormal" or N == "IsSubnormal" or N == "Class" or N == "BitwidthOf" or N == "PrecisionOf" or N == "ExponentBitwidthOf" or N == "TrailingSignificandBitwidthOf" or N == "ExponentBiasOf" or N == "SignednessOf" or N == "DomainOf" or N == "MaxFiniteOf" or N == "MinFiniteOf" or N == "MinPositiveOf" or N == "MaxSubnormalOf" or N == "MinNormalOf" or N == "NextGreaterThan" or N == "NextLessThan") [metadata "clause=4.3; page=19-20"] .
