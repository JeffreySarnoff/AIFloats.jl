  eq [p3109-conformance-057] : disjointCodes(ccons(C, CS), DS) = (not memberCode(C, DS) and disjointCodes(CS, DS)) [metadata "clause=4.4-4.6; page=21-24"] .
  eq [p3109-conformance-058] : uniqueCodes(cnil) = true [metadata "clause=4.4-4.6; page=21-24"] .
