  eq [p3109-result-block-reduction-numeric] : numericResult(blockReduction(N, A, FS, PS)) = true [metadata "clause=4.4; page=21"] .
  eq [p3109-result-block-scale-numeric] : numericResult(blockScale(N, A, FS, PS, BP)) = true [metadata "clause=4.4; page=21"] .
  eq [p3109-declared-exact] : declaredIdentity(exact(S, NAME, E)) = S [metadata "clause=4.6; page=24"] .
  eq [p3109-declared-approximate] : declaredIdentity(approximate(S, NAME, K, E)) = S [metadata "clause=4.6; page=24"] .
  eq [p3109-declared-empty] : hasDeclaration(S, dnil) = false [metadata "clause=4.6; page=24"] .
  eq [p3109-declared-member] : hasDeclaration(S, dcons(DEC, DECS)) = ((wellFormedDeclaration(DEC) and declaredIdentity(DEC) == S) or hasDeclaration(S, DECS)) [metadata "clause=4.6; page=24"] .
  eq [p3109-declarations-cover-empty] : declarationsCover(snil, DECS) = true [metadata "clause=4.5-4.6; page=22-24"] .
  eq [p3109-declarations-cover-cons] : declarationsCover(scons(S, SPECS), DECS) = (hasDeclaration(S, DECS) and declarationsCover(SPECS, DECS)) [metadata "clause=4.5-4.6; page=22-24"] .
  eq [p3109-partition-union-empty] : partitionUnion(pnil) = cnil [metadata "clause=4.4; page=21"] .
  eq [p3109-partition-union-cons] : partitionUnion(pcons(CS, PARTS)) = appendCodes(CS, partitionUnion(PARTS)) [metadata "clause=4.4; page=21"] .
  eq [p3109-partition-disjoint-empty] : partitionDisjoint(pnil) = true [metadata "clause=4.4; page=21"] .
  eq [p3109-partition-disjoint-cons] : partitionDisjoint(pcons(CS, PARTS)) = (uniqueCodes(CS) and disjointCodes(CS, partitionUnion(PARTS)) and partitionDisjoint(PARTS)) [metadata "clause=4.4; page=21"] .
  eq [p3109-partition-general] : partition(CS, PARTS) = (uniqueCodes(CS) and partitionDisjoint(PARTS) and subsetCodes(CS, partitionUnion(PARTS)) and subsetCodes(partitionUnion(PARTS), CS)) [metadata "clause=4.4; page=21"] .
  ceq [p3109-block-conversion-arity] : blockElementArity(N, A) = true if A == 3 /\ (N == "ConvertFromBlock" or N == "ConvertToBlock") [metadata "clause=5.5.1-5.5.2; page=64-65"] .
  ceq [p3109-block-element-arity-1] : blockElementArity(N, A) = true if A == 4 /\ (N == "BlockConvert" or N == "BlockAbs" or N == "BlockNegate" or N == "BlockSqrt" or N == "BlockRecip" or N == "BlockRSqrt" or N == "BlockExp" or N == "BlockExp2" or N == "BlockLog" or N == "BlockLog2" or N == "BlockLogOnePlus" or N == "BlockExpMinusOne" or N == "BlockSin" or N == "BlockCos" or N == "BlockTan" or N == "BlockArcSin" or N == "BlockArcCos" or N == "BlockArcTan" or N == "BlockSinh" or N == "BlockCosh" or N == "BlockTanh" or N == "BlockArcSinh" or N == "BlockArcCosh" or N == "BlockArcTanh" or N == "BlockSinPi" or N == "BlockCosPi" or N == "BlockTanPi" or N == "BlockArcSinPi" or N == "BlockArcCosPi" or N == "BlockArcTanPi" or N == "BlockSoftplus") [metadata "clause=5.7; page=69"] .
  ceq [p3109-block-element-arity-2] : blockElementArity(N, A) = true if A == 6 /\ (N == "BlockCopySign" or N == "BlockAdd" or N == "BlockSubtract" or N == "BlockMultiply" or N == "BlockDivide" or N == "BlockHypot" or N == "BlockArcTan2" or N == "BlockArcTan2Pi" or N == "BlockMinimum" or N == "BlockMaximum" or N == "BlockMinimumNumber" or N == "BlockMaximumNumber" or N == "BlockMinimumMagnitude" or N == "BlockMaximumMagnitude" or N == "BlockMinimumMagnitudeNumber" or N == "BlockMaximumMagnitudeNumber" or N == "BlockMinimumFinite" or N == "BlockMaximumFinite") [metadata "clause=5.7; page=69"] .
  ceq [p3109-block-element-arity-3] : blockElementArity(N, A) = true if A == 8 /\ (N == "BlockFMA" or N == "BlockFAA" or N == "BlockClamp") [metadata "clause=5.7; page=69"] .
  eq [p3109-block-element-arity-other] : blockElementArity(N, A) = false [owise metadata "clause=5.7; page=69"] .
  ceq [p3109-scaled-decl-arity-1] : numericArity(N, A) = true if A == 3 /\ (N == "ScaledConvert" or N == "ScaledAbs" or N == "ScaledNegate" or N == "ScaledSqrt" or N == "ScaledRecip" or N == "ScaledRSqrt" or N == "ScaledExp" or N == "ScaledExp2" or N == "ScaledLog" or N == "ScaledLog2" or N == "ScaledLogOnePlus" or N == "ScaledExpMinusOne" or N == "ScaledSin" or N == "ScaledCos" or N == "ScaledTan" or N == "ScaledArcSin" or N == "ScaledArcCos" or N == "ScaledArcTan" or N == "ScaledSinh" or N == "ScaledCosh" or N == "ScaledTanh" or N == "ScaledArcSinh" or N == "ScaledArcCosh" or N == "ScaledArcTanh" or N == "ScaledSinPi" or N == "ScaledCosPi" or N == "ScaledTanPi" or N == "ScaledArcSinPi" or N == "ScaledArcCosPi" or N == "ScaledArcTanPi" or N == "ScaledSoftplus") [metadata "clause=5.8; page=70"] .
  ceq [p3109-scaled-decl-arity-2] : numericArity(N, A) = true if A == 5 /\ (N == "ScaledCopySign" or N == "ScaledAdd" or N == "ScaledSubtract" or N == "ScaledMultiply" or N == "ScaledDivide" or N == "ScaledHypot" or N == "ScaledArcTan2" or N == "ScaledArcTan2Pi" or N == "ScaledMinimum" or N == "ScaledMaximum" or N == "ScaledMinimumNumber" or N == "ScaledMaximumNumber" or N == "ScaledMinimumMagnitude" or N == "ScaledMaximumMagnitude" or N == "ScaledMinimumMagnitudeNumber" or N == "ScaledMaximumMagnitudeNumber" or N == "ScaledMinimumFinite" or N == "ScaledMaximumFinite") [metadata "clause=5.8; page=70"] .
  ceq [p3109-scaled-decl-arity-3] : numericArity(N, A) = true if A == 7 /\ (N == "ScaledFMA" or N == "ScaledFAA" or N == "ScaledClamp") [metadata "clause=5.8; page=70"] .
  eq [p3109-decl-partitioned-valid] : wellFormedDeclaration(partitioned(S, NAME, CS, KP, E)) = (NAME =/= "" and NAME =/= specializationName(S) and numericResult(S) and validSpecialization(S) and partition(CS, partRegions(KP))) [metadata "clause=4.4; page=21"] .
  eq [p3109-decl-partitioned-identity] : declaredIdentity(partitioned(S, NAME, CS, KP, E)) = S [metadata "clause=4.4; page=21"] .
  eq [p3109-part-regions-empty] : partRegions(knil) = pnil [metadata "clause=4.4; page=21"] .
  eq [p3109-part-regions-cons] : partRegions(kcons(kappaPart(CS, K), KP)) = pcons(CS, partRegions(KP)) [metadata "clause=4.4; page=21"] .
  eq [p3109-part-bound-empty] : partBound(knil) = steps(0) [metadata "clause=4.4; page=21"] .
  eq [p3109-part-bound-cons] : partBound(kcons(kappaPart(CS, K), KP)) = mergeKappa(K, partBound(KP)) [metadata "clause=4.4; page=21"] .
  ceq [p3109-decl-exact-kappa] : declarationKappa(exact(S, NAME, E)) = steps(0) if wellFormedDeclaration(exact(S, NAME, E)) /\ numericResult(S) [metadata "clause=4.4; page=21"] .
  ceq [p3109-decl-approx-kappa] : declarationKappa(approximate(S, NAME, K, E)) = K if wellFormedDeclaration(approximate(S, NAME, K, E)) [metadata "clause=4.4; page=21"] .
  ceq [p3109-decl-partition-kappa] : declarationKappa(partitioned(S, NAME, CS, KP, E)) = partBound(KP) if wellFormedDeclaration(partitioned(S, NAME, CS, KP, E)) [metadata "clause=4.4; page=21"] .
endfm
