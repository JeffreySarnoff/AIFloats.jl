  ceq [p3109-conformance-037] : finiteRank(F, C) = C if validCode(F, C) /\ internalFormat(F) /\ IsFinite(F, C) /\ SignednessOf(F) == Unsigned [metadata "clause=4.4-4.6; page=21-24"] .
  ceq [p3109-conformance-038] : finiteRank(F, C) = MaxFiniteOf(F) + C if validCode(F, C) /\ internalFormat(F) /\ IsFinite(F, C) /\ SignednessOf(F) == Signed /\ not IsSignMinus(F, C) [metadata "clause=4.4-4.6; page=21-24"] .
  ceq [p3109-conformance-039] : finiteRank(F, C) = MinFiniteOf(F) - C if validCode(F, C) /\ internalFormat(F) /\ IsFinite(F, C) /\ IsSignMinus(F, C) [metadata "clause=4.4-4.6; page=21-24"] .
  ceq [p3109-conformance-040] : observationKappa(observation(N, CS, F, C, D)) = kNaN if validCode(F, C) /\ validCode(F, D) /\ IsNaN(F, C) =/= IsNaN(F, D) [metadata "clause=4.4-4.6; page=21-24"] .
  ceq [p3109-conformance-041] : observationKappa(observation(N, CS, F, C, D)) = steps(0) if validCode(F, C) /\ validCode(F, D) /\ IsNaN(F, C) /\ IsNaN(F, D) [metadata "clause=4.4-4.6; page=21-24"] .
  ceq [p3109-conformance-042] : observationKappa(observation(N, CS, F, C, D)) = steps(0) if validCode(F, C) /\ validCode(F, D) /\ IsInfinite(F, C) /\ IsInfinite(F, D) /\ IsSignMinus(F, C) == IsSignMinus(F, D) [metadata "clause=4.4-4.6; page=21-24"] .
  ceq [p3109-conformance-043] : observationKappa(observation(N, CS, F, C, D)) = kInfinity if validCode(F, C) /\ validCode(F, D) /\ not IsNaN(F, C) /\ not IsNaN(F, D) /\ (IsInfinite(F, C) or IsInfinite(F, D)) /\ not (IsInfinite(F, C) and IsInfinite(F, D) and IsSignMinus(F, C) == IsSignMinus(F, D)) [metadata "clause=4.4-4.6; page=21-24"] .
  ceq [p3109-conformance-044] : observationKappa(observation(N, CS, F, C, D)) = steps(abs(finiteRank(F, C) - finiteRank(F, D))) if validCode(F, C) /\ validCode(F, D) /\ IsFinite(F, C) /\ IsFinite(F, D) [metadata "clause=4.4-4.6; page=21-24"] .
  eq [p3109-conformance-045] : batchKappa(onil) = steps(0) [metadata "clause=4.4-4.6; page=21-24"] .
  eq [p3109-conformance-046] : batchKappa(ocons(O, OS)) = mergeKappa(observationKappa(O), batchKappa(OS)) [metadata "clause=4.4-4.6; page=21-24"] .
  eq [p3109-conformance-047] : mergeKappa(kNaN, K) = kNaN [metadata "clause=4.4-4.6; page=21-24"] .
  eq [p3109-conformance-048] : mergeKappa(kInfinity, kNaN) = kNaN [metadata "clause=4.4-4.6; page=21-24"] .
