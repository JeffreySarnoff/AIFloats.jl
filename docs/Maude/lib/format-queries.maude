--- Source: P3109/D1 4.14, printed page 58.
fmod P3109-FORMAT-QUERIES is
  including P3109-CODEC .
  ops MaxFiniteOf MinFiniteOf MinPositiveOf MaxSubnormalOf MinNormalOf : Format ~> Nat .
  var F : Format .
  ceq [p3109-format-queries-001] : MaxFiniteOf(F) = positiveLimit(F) - (if DomainOf(F) == Extended then 1 else 0 fi) if validFormat(F) /\ internalFormat(F) [metadata "clause=4.14; page=58"] .
  ceq [p3109-format-queries-002] : MinFiniteOf(F) = if SignednessOf(F) == Signed then MaxFiniteOf(F) + 2 ^ (BitwidthOf(F) - 1) else 0 fi if validFormat(F) /\ internalFormat(F) [metadata "clause=4.14; page=58"] .
  ceq [p3109-format-queries-003] : MinPositiveOf(F) = 1 if validFormat(F) /\ internalFormat(F) [metadata "clause=4.14; page=58"] .
  ceq [p3109-format-queries-004] : MaxSubnormalOf(F) = if PrecisionOf(F) == 1 then nanCode(F) else 2 ^ (PrecisionOf(F) - 1) - 1 fi if validFormat(F) /\ internalFormat(F) [metadata "clause=4.14; page=58"] .
  ceq [p3109-format-queries-005] : MinNormalOf(F) = 2 ^ (PrecisionOf(F) - 1) if validFormat(F) /\ internalFormat(F) [metadata "clause=4.14; page=58"] .
  ceq [p3109-format-queries-006] : MaxFiniteOf(F) = externalBound(F, "MaxFiniteOf") if validFormat(F) /\ not internalFormat(F) [metadata "clause=4.14; page=58"] .
  ceq [p3109-format-queries-007] : MinFiniteOf(F) = externalBound(F, "MinFiniteOf") if validFormat(F) /\ not internalFormat(F) [metadata "clause=4.14; page=58"] .
  ceq [p3109-format-queries-008] : MinPositiveOf(F) = externalBound(F, "MinPositiveOf") if validFormat(F) /\ not internalFormat(F) [metadata "clause=4.14; page=58"] .
  ceq [p3109-format-queries-009] : MaxSubnormalOf(F) = externalBound(F, "MaxSubnormalOf") if validFormat(F) /\ not internalFormat(F) [metadata "clause=4.14; page=58"] .
  ceq [p3109-format-queries-010] : MinNormalOf(F) = externalBound(F, "MinNormalOf") if validFormat(F) /\ not internalFormat(F) [metadata "clause=4.14; page=58"] .
endfm
